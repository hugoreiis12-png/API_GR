# Credenciais GRSA (fuzzing.js)
GRSA_EMAIL=
GRSA_PASS=
GRSA_GOC_SESSION=

# Auth Bubble / JWT (sync-api.js)
JWT_SECRET=
JWT_EXPIRY_HOURS=12

# Webhooks
N8N_WEBHOOK_URL=http://192.168.0.231:5678/webhook/af-dump-trigger
BUBBLE_WEBHOOK_URL=https://comprover.bubbleapps.io/api/1.1/wf/chave_gr

# Runtime
SYNC_PORT=3005
DUMP_DIR=/app/data
CHROME_PATH=/usr/bin/chromium
TZ=America/Sao_Paulo

# Rodar a coleta uma vez ao subir o container (alem do cron das 11:59).
# true = valida o deploy sem esperar o horario. Default: false.
RUN_ON_START=false